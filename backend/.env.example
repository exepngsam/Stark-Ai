# Optional AWS Bedrock & Textract Configuration
# If left empty, STARK AI automatically runs in high-fidelity "Local Demo Mode"
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model settings (e.g., anthropic.claude-3-5-sonnet-20240620-v1:0 or amazon.titan-text-express-v1)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
